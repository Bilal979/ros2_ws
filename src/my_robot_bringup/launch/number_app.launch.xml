<launch>
    <!-- <node pkg="my_py_pkg" exec="number_publisher"></node>
    <node pkg="my_py_pkg" exec="number_counter"></node> -->

    <!-- Include a python launch file-->
    <!-- <include file="$(find-pkg-share my_robot_bringup)/launch/number_app.launch.py"></include> -->

    <!--Node renaming and remapping |  Can remap topic|service|action-->
    <node pkg='my_py_pkg' exec='number_publisher' name='num_pub1'>
        <remap from='/number' to='/my_number'/>
        <param name='number' value='1'/>
        <param name='publish_period' value='2.0'/>
    </node>
    <node pkg='my_py_pkg' exec='number_publisher' name='num_pub2'>
        <remap from='/number' to='/my_number'/>
        <param name='number' value='2'/>
        <param name='publish_period' value='4.0'/>
    </node>
    <node pkg='my_py_pkg' exec='number_counter'>
        <remap from='/number' to='/my_number'/>
    </node>
</launch>