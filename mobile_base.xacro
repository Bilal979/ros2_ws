<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Xacro properties -->
        <xacro:property name="base_length" value="0.6"/>
        <xacro:property name="base_width" value="0.4"/>
        <xacro:property name="base_height" value="0.2"/>
        <xacro:property name="wheel_radius" value="0.1"/>
        <xacro:property name="wheel_length" value="0.05"/>

        <!-- Xacro macros -->
        <xacro:macro name="wheel_link" params="prefix">
            <link name="${prefix}_wheel_link">
                <visual>
                    <geometry>
                        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                    </geometry>
                    <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                    <material name="gray"/>
                </visual>
            </link>
        </xacro:macro>



        <!-- Base link -->
        <link name="base_link">
            <visual>
                <geometry>
                    <box size="${base_length} ${base_width} ${base_height}"/>
                </geometry>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <material name="green"/>
            </visual>
        </link>

        <!-- Right wheel link -->
        <xacro:wheel_link prefix="right"/>

        <!-- Right wheel and base link joint -->
        <joint name="base_right_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="right_wheel_link"/>
            <!-- <origin xyz="-0.15 -0.225 0" rpy="0 0 0"/> -->
            <origin xyz="${-base_length/4} ${-(base_width+wheel_length)/2} 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <!-- Left wheel link -->
        <xacro:wheel_link prefix="left"/>

        <!-- Left wheel and base link joint -->
        <joint name="base_left_wheel_link" type="continuous">
            <parent link="base_link"/>
            <child link="left_wheel_link"/>
            <!-- <origin xyz="-0.15 0.225 0" rpy="0 0 0"/> -->
            <origin xyz="${-base_length/4} ${(base_width + wheel_length)/2} 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <!-- Caster wheel link -->
        <link name="caster_wheel_link">
            <visual>
                <geometry>
                    <sphere radius="${wheel_radius/2}"/>
                </geometry>
                <material name="gray"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </visual>
        </link>

        <!-- Caster wheel and base joint -->
        <joint name="base_caster_wheel_joint" type="fixed">
            <parent link="base_link"/>
            <child link="caster_wheel_link"/>
            <origin xyz="${base_length/3} 0 ${-wheel_radius/2}" rpy="0 0 0"/>
        </joint>


        <!-- Base footprint link -->
        <link name="base_footprint"/>

        <!-- Base footprint and Base link joint -->
        <joint name="base_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>            
        </joint>
</robot>